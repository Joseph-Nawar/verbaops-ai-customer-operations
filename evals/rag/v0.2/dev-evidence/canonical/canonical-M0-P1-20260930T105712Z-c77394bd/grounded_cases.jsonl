{"agent_run_id": "4fbc07bd-c615-4096-986c-722b536e62ad", "answer_latency_ms": 1195.509, "capability_alias": "agent-fast", "case_id": "m5d-v02-shipping-010", "cost_observations": 1, "cost_usd": 0.00026895, "evaluated_git_sha": "7f82c565e7f9fc085f2d81c2c04a9861444837a1", "evaluation_inter_case_delay_seconds": 20.0, "evaluation_worktree_dirty": false, "final_answer": "Support can begin an investigation once the carrier\u2019s promised delivery date has passed\u202f\u2014\u202fthat is, when the parcel is overdue according to the carrier\u2019s stated delivery date\u3010K1\u3011. The same guidance appears in the Shipping FAQ, which advises customers to contact support for an investigation after the expected delivery date has elapsed\u3010K4\u3011.", "gateway_model_id": "3e62a8be369366f18319209dad555e8b8eee61bb30151ccd74314984f0404b39", "model": "groq/openai/gpt-oss-120b", "model_call_count": 1, "provider": null, "public_citations": [], "repair_attempted": false, "repair_cost_usd": null, "repair_failed_reason": null, "repair_model_latency_ms": null, "repair_succeeded": false, "run_id": "canonical-M0-P1-20260930T105712Z-c77394bd", "run_identity_sha256": "d79238b2a90b3b1cc1733c61f55632157a64268884d4ddb892deec0001ff182b", "selected_evidence": ["shipping-policy|2026.1|Tracking and delays|2", "refund-policy|2026.1|Partial refunds|2", "shipping-policy|2026.1|Address changes|3", "faq-shipping|2026.1|Tracking has not updated|1", "faq-payments|2026.1|What if payment fails?|2"], "status": "completed", "tool_call_count": 0, "top_confidence_score": 0.9871955}
